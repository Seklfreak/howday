// Copy this file to Secrets.xcconfig (gitignored) and fill in your values
// from the Supabase dashboard: Project Settings -> API.
//
// Note the $() in the URL: xcconfig treats // as a comment, so the slashes
// must be split. The value resolves to https://<ref>.supabase.co
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Sentry crash reporting (Project Settings -> Client Keys). Optional: leave
// empty to disable Sentry entirely. Same // gotcha as above — split the
// slashes with $().
SENTRY_DSN =
